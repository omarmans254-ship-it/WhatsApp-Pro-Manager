{
  "name": "whatsapp-multi-account",
  "version": "2.0.4",
  "author": "Antigravity",
  "description": "Multi-account WhatsApp Web Client",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.antigravity.whatsapppromanager",
    "productName": "WhatsApp Pro Manager",
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "omarmans254-ship-it",
        "repo": "WhatsApp-Pro-Manager"
      }
    ]
  },
  "dependencies": {
    "adm-zip": "^0.6.0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2"
  }
}
